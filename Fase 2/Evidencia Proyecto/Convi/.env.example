# NO subas .env. Cada integrante tendra sus propias claves locales.
WEB_PORT=3000
API_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321

# El script scripts/iniciar.ps1 completa estas variables automaticamente.
# PUBLISHABLE es de cliente; SECRET es SOLO de servidor (NestJS).
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Se mantienen durante la transicion desde las claves legacy.
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Solo API. Docker tiene un valor para Supabase local.
# Fuera de Docker, configurar la conexión privada a PostgreSQL.
SUPABASE_DB_URL=
