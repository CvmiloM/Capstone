# NO subas .env. Cada integrante tendra sus propias claves locales.
WEB_PORT=3000
API_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
SUPABASE_URL=http://host.docker.internal:54321

# El script completa las claves locales en .env; nunca modifica .env.cloud.
# PUBLISHABLE es de cliente; SECRET es SOLO de servidor (NestJS).
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Se mantienen durante la transicion desde las claves legacy.
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Solo API. Docker tiene un valor para Supabase local.
# En cloud, configurar PostgreSQL con sslmode=verify-full en .env.cloud.
SUPABASE_DB_URL=

# Solo API: cola de la confirmación de importaciones (PB-027).
# Docker usa su Redis local; en la nube, la URL completa (rediss://...) va como secreto.
REDIS_URL=

# Solo API, PB-079: URL completa del servicio compatible con POST /api/embed de Ollama.
# Modelo requerido por la base: bge-m3:567m-fp16, 1024 dimensiones.
# Local con convi-ia (apps/ia): http://host.docker.internal:8000/api/embed, sin token
# mientras convi-ia escuche solo en el equipo. Producción: HTTPS con token, el mismo
# valor de IA_EMBEDDINGS_TOKEN que recibe convi-ia.
IA_EMBEDDINGS_URL=
IA_EMBEDDINGS_TOKEN=

# Solo API, PB-117 a PB-119: consulta del reglamento, POST /api/chat del mismo convi-ia.
# Local: http://host.docker.internal:8000/api/chat, usa el mismo IA_EMBEDDINGS_TOKEN.
# Modelo que redacta: qwen3.5:9b, se descarga con ollama pull qwen3.5:9b.
IA_GENERACION_URL=
